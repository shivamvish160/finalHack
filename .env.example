# GCP_PROJECT_ID must be the SAME project that already hosts the existing
# BigQuery warehouse (sre_telemetry, sre_topology, sre_knowledge_base,
# sre_incident_mart) -- this platform never provisions that warehouse itself.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# BigQuery -- existing warehouse (read-mostly; see data-model.md)
BQ_TELEMETRY_DATASET=sre_telemetry
BQ_TOPOLOGY_DATASET=sre_topology
BQ_KNOWLEDGE_BASE_DATASET=sre_knowledge_base
BQ_INCIDENT_MART_DATASET=sre_incident_mart
# New, platform-owned dataset for the BQML forecast model only (data-model.md §5)
BQ_ML_OPS_DATASET=sre_ml_ops

# Vertex AI / Gemini
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_RCA=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-005

# Pub/Sub topics (contracts/pubsub-events.md)
PUBSUB_TOPIC_ALERTS_REPLAY=alerts.replay

# Firebase Authentication (RBAC) -- Secret Manager holds the actual credentials;
# this only names the secret, never the credential value itself.
FIREBASE_ADMIN_CREDENTIALS_SECRET_NAME=firebase-admin-sdk-credentials

# Runbook / prediction similarity thresholds (tunable per research.md/quickstart.md)
RUNBOOK_SIMILARITY_THRESHOLD=0.72
PREDICTION_CONFIDENCE_THRESHOLD=0.65

# Alert replay throughput target (FR-004, NFR-001)
ALERT_REPLAY_TARGET_MSGS_PER_MINUTE=1000

# demo-target-service (sandbox execution target, never production)
DEMO_TARGET_SERVICE_URL=https://demo-target-service-REPLACE.a.run.app
